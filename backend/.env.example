# PostgreSQL / Neon connection string (required by PrismaService)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"

# Google Gemini is used only by the backend PlantDiscovery endpoint.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# Cloudinary image storage. Obtain these from the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# URL used in password-reset emails.
FRONTEND_URL="http://localhost:5173"
PORT=3000
